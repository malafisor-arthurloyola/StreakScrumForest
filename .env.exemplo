# Modelo de configuracao para o scripts/sync_gitlab.py (integracao com o GitLab).
# COPIE este arquivo para ".env" (na pasta do projeto) e preencha os valores.
# O ".env" fica so no seu computador e NUNCA e versionado (esta no .gitignore).
# NUNCA coloque o token aqui dentro do arquivo versionado nem compartilhe o .env.

# Endereco base do GitLab (so o dominio, sem o caminho do projeto)
GITLAB_URL=https://git.inteli.edu.br

# O projeto: pode ser o Project ID numerico (ex.: 1234) ou o caminho com barras.
GITLAB_PROJECT=graduacao/2026-2b/t24/g01

# Seu token PESSOAL do GitLab, com escopo de LEITURA (read_api). De preferencia com
# expiracao curta; revogue-o no GitLab quando nao precisar mais.
GITLAB_TOKEN=glpat-COLOQUE_SEU_TOKEN_AQUI

# (Opcional) Nomes das labels das colunas, caso nao sejam exatamente estes:
# GITLAB_LABEL_DOING=Doing
# GITLAB_LABEL_REVIEW=Waiting review

# Para ENVIAR para o site (nao precisa para --simular / --listar-usuarios).
# Defina o(s) destino(s) que voce usa. Voce pode ter os dois e escolher na hora:
#   python scripts/sync_gitlab.py --destino producao   (ou local, ou ambos)
# Sem --destino, vai para o publicado (se existir) ou para o unico configurado.
SITE_URL_PRODUCAO=https://SEUUSUARIO.pythonanywhere.com
# SITE_URL_LOCAL=http://localhost:5000

# O segredo compartilhado: o MESMO valor definido como SYNC_TOKEN no servidor.
# (Se o site local usar um SYNC_TOKEN diferente, use SITE_SYNC_TOKEN_LOCAL / SITE_SYNC_TOKEN_PRODUCAO.)
SITE_SYNC_TOKEN=troque-por-um-segredo-forte
